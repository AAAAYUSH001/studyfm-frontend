{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "env": {
    "VITE_API_URL": "@studyfm_api_url",
    "VITE_GEMINI_API_KEY": "@studyfm_gemini_key",
    "VITE_GEMINI_MODEL": "gemini-3-flash-preview"
  }
}
